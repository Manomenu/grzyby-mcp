{
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.import_linter_cache": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/dist": true
    },
    // File nesting (AGENTS.md, "File nesting"): a file's tests and companions fold under it,
    // so the explorer shows one entry per module. Extend these patterns, don't fight them.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "README.md": "AGENTS.md, CLAUDE.md, TODO.md, justfile, ruff.toml, .editorconfig, .gitignore, .gitattributes, .dockerignore, compose.yaml",
        "pyproject.toml": "uv.lock, pyrightconfig.json, .python-version",
        ".env.base": ".env, .env.example",
        "package.json": "pnpm*, .npm*, eslint*, .eslint*, prettier*, .prettier*, knip.json, tsconfig*.json, vite.config.ts, index.html",
        "*.ts": "${capture}.js, ${capture}.*.ts",
        "*.tsx": "${capture}.ts, ${capture}.*.ts, ${capture}.*.tsx"
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["grzyby_server"],
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "eslint.workingDirectories": ["grzyby_web"],
    "prettier.prettierPath": "grzyby_web/node_modules/prettier"
}
