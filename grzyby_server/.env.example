# Origins the web UI is served from — JSON list. Only matters when the browser calls the
# API directly; behind the vite proxy or nginx it sees one origin and CORS never comes up.
CORS_ORIGINS=["http://localhost:3210"]

# Override the committed defaults from .env.base when the port is taken.
# PORT=6210

# The key /mcp asks for (mcp_key.py); unset — no check, as on a laptop. Never a real value here.
# MCP_KEY=a-long-random-string
# Open /mcp to anyone while a key is set (the cluster: chart server.allowPublic).
# ALLOW_PUBLIC=false
# CARTO's key for the map's tiles (carto.com/basemaps/apikey); unset — tiles with a watermark.
# CARTO_KEY=cb1_your_key
