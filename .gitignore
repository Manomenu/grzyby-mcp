# Secrets and machine-local settings. Committed defaults live in .env.base, documented
# overrides in .env.example; the real values never enter git (AGENTS.md, "Secrets").
**/.env
**/.env.local
.secrets/
*.pem
*.key
*.p12
id_rsa*
id_ed25519*

# Python
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.import_linter_cache/
**/.coverage
**/htmlcov/

# Web
**/node_modules/
**/dist/
**/build/
**/*.tsbuildinfo

# Everything generated (e2e reports, renders, graphs) goes to .artifacts/, never next to code.
.artifacts/*
!.artifacts/.gitkeep
**/logs/

# Agents' scratch space
.claude/worktrees/
scratchpad/
